# ─────────────────────────────────────────────
# Конфигурация платформы маркетплейса
# ─────────────────────────────────────────────
# Скопируйте этот файл в .env и заполните свои значения.
#   cp .env.example .env
# ─────────────────────────────────────────────

# --- База данных PostgreSQL ---
MP_DB_HOST=127.0.0.1
MP_DB_PORT=5432
MP_DB_USER=mp_user
MP_DB_PASSWORD=your_secure_password_here
MP_DB_NAME=marketplace_platform

# --- JWT-аутентификация ---
MP_JWT_SECRET=your_jwt_secret_here_min_32_chars
MP_JWT_ALGORITHM=HS256
MP_JWT_EXPIRE_MINUTES=60

# --- CORS (разрешённые источники через запятую) ---
MP_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# --- Логирование ---
MP_LOG_LEVEL=INFO
